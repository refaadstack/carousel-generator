# 9router OpenAI-compatible endpoint (dipakai server untuk generate konten).
AI_BASE_URL="http://host.docker.internal:8794/v1"
AI_API_KEY="your-9router-api-key"
AI_MODEL="coding"

# MySQL eksternal (LXC db-mysql). Jangan pakai container database di host ini.
DB_HOST="192.168.1.250"
DB_PORT="3306"
DB_USER="kael"
DB_PASSWORD="isi-password-db"
DB_NAME="carousel_generator"
